{
  "name": "alisoglu-project-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-vendor.mjs && vite --host 127.0.0.1 --port 8780",
    "build": "node scripts/prepare-vendor.mjs && vite build && node scripts/finalize-build.mjs && node scripts/build-discovery.mjs && node scripts/build-offline-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8780",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:enhancements": "node scripts/fileforge-enhancements.mjs",
    "test:pages": "node scripts/site-pages.mjs",
    "test:next": "node scripts/fileforge-next.mjs",
    "test:ocr": "node scripts/fileforge-ocr.mjs",
    "test:offline": "node scripts/offline-smoke.mjs",
    "test:workspace": "node scripts/workspace-smoke.mjs",
    "test:background": "node scripts/background-editor-check.mjs",
    "test:finder": "node scripts/tool-switcher-smoke.mjs",
    "test:image-preview": "node scripts/image-preview-check.mjs",
    "test:workflow": "node scripts/workflow-refinement-check.mjs",
    "test:workshop": "node scripts/workshop-workflow.mjs",
    "test:screenshot": "node scripts/screenshot-studio-check.mjs",
    "test:finish": "node scripts/finish-tools-check.mjs",
    "test:scanner": "node scripts/scanner-check.mjs",
    "test:documents": "node scripts/document-tools-check.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.4.0",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@pdf-lib/fontkit": "1.1.1",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tur": "1.0.0",
    "docx-preview": "0.4.1",
    "fflate": "0.8.3",
    "heic-to": "1.6.6",
    "html2canvas": "1.4.1",
    "imagetracerjs": "1.2.6",
    "onnxruntime-web": "1.30.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
