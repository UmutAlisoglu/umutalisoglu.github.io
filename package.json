{
  "name": "alisoglu-project-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-vendor.mjs && vite --host 127.0.0.1 --port 8780",
    "build": "node scripts/prepare-vendor.mjs && vite build && node scripts/finalize-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8780",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:enhancements": "node scripts/fileforge-enhancements.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@pdf-lib/fontkit": "1.1.1",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
